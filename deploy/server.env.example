# Copy to .env.local and replace placeholders. Never commit the real file.
DATABASE_URL=postgresql://sephora:REPLACE_PASSWORD@127.0.0.1:5432/sephora
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_URL=https://screens.example.com
# Optional exact additional origins, comma-separated. Leave empty for production.
AUTH_ADDITIONAL_ORIGINS=
# Private-network testing only. Keep false for public/company production hosting.
ALLOW_LAN_HTTP=false
AUTH_ADMIN_EMAIL=admin@example.com
# Generate these with scripts/create-bootstrap.mjs for an empty database only.
AUTH_BOOTSTRAP_HASH=
AUTH_BOOTSTRAP_EXPIRES=
# Only enable after the reverse proxy replaces untrusted client IP headers.
TRUST_PROXY=false
HOSTNAME=127.0.0.1
PORT=3000
NEXT_TELEMETRY_DISABLED=1
# Optional Gmail sender. Use a Google App Password, never your account password.
# Leave empty to keep email alerts unavailable until configured.
ALERT_EMAIL_USER=
ALERT_EMAIL_APP_PASSWORD=

# UltraMsg credentials stay on the server. Individual recipient numbers are saved in Settings.
ULTRAMSG_INSTANCE_ID=instance8591
ULTRAMSG_TOKEN=

# Optional read-only OnSign API token with player:read access. Never use NEXT_PUBLIC_.
ONSIGN_API_TOKEN=
# Optional stable organization ID. When empty, resolve the unique organization named Sephora.
# The ID takes precedence, including after an organization rename. Never use another brand's ID.
ONSIGN_ORGANIZATION_ID=

# Private persistent photos. Prefer an absolute folder outside the deployment checkout.
# Blank defaults to uploads/screen-photos under the server working directory. Back up this folder.
SCREEN_PHOTO_DIR=
