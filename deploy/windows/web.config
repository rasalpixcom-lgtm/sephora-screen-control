<?xml version="1.0" encoding="utf-8"?>
<!-- Place this in the IIS reverse-proxy site, not the application source directory.
     Install IIS URL Rewrite + ARR and enable ARR proxying first.
     Bind HTTPS in IIS. Set the application's PORT=3000 and HOSTNAME=127.0.0.1.
     Configure IIS to replace X-Forwarded-For with the real remote IP before TRUST_PROXY=true. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Sephora Node proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
